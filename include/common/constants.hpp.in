#pragma once

#include <cstddef>
#include <cstdint>

namespace velodb {

constexpr int VERSION_MAJOR = @PROJECT_VERSION_MAJOR@;
constexpr int VERSION_MINOR = @PROJECT_VERSION_MINOR@;
constexpr int VERSION_PATCH = @PROJECT_VERSION_PATCH@;
constexpr const char* VERSION_STRING = "@PROJECT_VERSION@";

// Reduced from 1<<25 to 1<<22 to reduce GPU memory pressure for large scale factors
// 1<<22 = 4M rows, which is a good balance between throughput and memory usage
constexpr size_t MAX_BATCH_SIZE = 1ul << 22;
constexpr size_t MAX_SORT_COLUMNS = 8;

}
